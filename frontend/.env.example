# Backend REST API endpoint base URL
# Local development:
# VITE_API_BASE_URL=http://localhost:8080/api
# Production (Render):
# VITE_API_BASE_URL=https://<your-backend>.onrender.com/api
VITE_API_BASE_URL=http://localhost:8080/api

# Backend WebSocket endpoint base URL
# Local development:
# VITE_WS_BASE_URL=ws://localhost:8080/api
# Production (Render):
# VITE_WS_BASE_URL=wss://<your-backend>.onrender.com/api
VITE_WS_BASE_URL=ws://localhost:8080/api

# Frontend URL (optional, defaults to https://live-poll-ashy.vercel.app)
VITE_APP_URL=https://live-poll-ashy.vercel.app

